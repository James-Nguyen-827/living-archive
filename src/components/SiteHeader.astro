---
import { navigation, site } from '../config/site';
const pathname = Astro.url.pathname;
---

<header class="site-header">
  <a class="site-mark" href="/" aria-label={`${site.name}, home`}>
    <span>LA</span>
  </a>
  <nav aria-label="Primary">
    <ul>
      {navigation.map((item) => (
        <li><a href={item.href} aria-current={pathname.startsWith(item.href) ? 'page' : undefined}>{item.label}</a></li>
      ))}
    </ul>
  </nav>
  <a class="index-link" href="/index">Index <span aria-hidden="true">↗</span></a>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 20;
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 2rem;
    align-items: center;
    min-height: var(--header-height);
    padding-inline: var(--page-gutter);
    border-bottom: 1px solid var(--line);
    background: color-mix(in oklch, var(--background), transparent 7%);
  }

  .site-mark {
    display: flex;
    align-items: baseline;
    font-family: var(--display);
    font-size: 1.25rem;
    font-weight: 600;
    text-decoration: none;
  }

  nav ul {
    display: flex;
    justify-content: center;
    gap: clamp(0.85rem, 2.2vw, 2.4rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a,
  .index-link {
    font-family: var(--display);
    font-size: 0.86rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-decoration: none;
    text-transform: uppercase;
  }

  nav a[aria-current='page'] {
    color: var(--coral);
  }

  @media (max-width: 52rem) {
    .site-header {
      grid-template-columns: 1fr auto;
    }

    .site-header nav {
      position: fixed;
      right: 0;
      bottom: 0;
      left: 0;
      z-index: 50;
      padding: 0.85rem 0.75rem calc(0.85rem + env(safe-area-inset-bottom));
      border-top: 1px solid var(--line);
      background: var(--background);
      overflow-x: auto;
      overscroll-behavior-inline: contain;
    }

    nav ul {
      justify-content: space-around;
      gap: 0.3rem;
      width: max-content;
      min-width: 100%;
    }

    nav a {
      font-size: 0.72rem;
      letter-spacing: 0.04em;
    }
  }
</style>
