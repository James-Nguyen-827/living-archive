---
import { getCollection } from 'astro:content';

const [employment, writing, projects, interests] = await Promise.all([
  getCollection('employment'),
  getCollection('writing'),
  getCollection('projects'),
  getCollection('interests', ({ data }) => !data.draft),
]);

const sections = [
  {
    title: 'Employment',
    href: '/employment',
    entries: employment.sort((a, b) => a.data.order - b.data.order).map((entry) => ({ title: entry.data.title, href: `/employment/${entry.id}` })),
  },
  {
    title: 'Blogs',
    href: '/writing',
    entries: writing.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()).map((entry) => ({ title: entry.data.title, href: `/writing/${entry.id}` })),
  },
  {
    title: 'Projects',
    href: '/projects',
    entries: projects.map((entry) => ({ title: entry.data.title, href: `/projects/${entry.id}` })),
  },
  {
    title: 'Interests',
    href: '/interests',
    entries: interests.map((entry) => ({ title: entry.data.title, href: `/interests/${entry.id}` })),
  },
  { title: 'About', href: '/about', entries: [] },
];
---

<ol class="full-index page-shell">
  {sections.map((section) => (
    <li>
      <h2><a href={section.href}>{section.title}</a></h2>
      {section.entries.length > 0 && (
        <ul>
          {section.entries.map((entry) => <li><a href={entry.href}>{entry.title}</a></li>)}
        </ul>
      )}
    </li>
  ))}
</ol>

<style>
  .full-index {
    margin-block: 0;
    padding-block: 2rem 4rem;
    list-style: none;
    display: grid;
    gap: 2.5rem;
  }

  .full-index h2 {
    margin: 0 0 0.75rem;
    font-size: 1.25rem;
  }

  .full-index ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.5rem;
  }

  .full-index a {
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }
</style>
