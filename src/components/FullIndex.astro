---
import { getCollection } from 'astro:content';

const [work, notes, archive] = await Promise.all([
  getCollection('work'),
  getCollection('notes'),
  getCollection('archive'),
]);

const sections = [
  {
    title: 'Work',
    href: '/work',
    entries: work.sort((a, b) => a.data.order - b.data.order).map((entry) => ({ title: entry.data.title, href: `/work/${entry.id}` })),
  },
  {
    title: 'Field Notes',
    href: '/notes',
    entries: notes.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()).map((entry) => ({ title: entry.data.title, href: `/notes/${entry.id}` })),
  },
  {
    title: 'Experiments',
    href: '/experiments',
    entries: archive.filter((entry) => entry.data.kind === 'experiment').map((entry) => ({ title: entry.data.title, href: `/experiments/${entry.id}` })),
  },
  {
    title: 'Hobbies',
    href: '/hobbies',
    entries: archive.filter((entry) => entry.data.kind === 'hobby').map((entry) => ({ title: entry.data.title, href: `/hobbies/${entry.id}` })),
  },
  { title: 'About', href: '/about', entries: [] },
];
---

<ol class="full-index page-shell">
  {sections.map((section) => (
    <li>
      <h2><a href={section.href}>{section.title}</a></h2>
      {section.entries.length > 0 && (
        <ul>
          {section.entries.map((entry) => <li><a href={entry.href}>{entry.title}</a></li>)}
        </ul>
      )}
    </li>
  ))}
</ol>

<style>
  .full-index {
    margin-block: 0;
    padding: 0 0 clamp(3rem, 8vw, 6rem);
    list-style: none;
  }

  .full-index > li {
    padding-block: clamp(1.5rem, 4vw, 2.5rem);
    border-bottom: 1px solid var(--line);
  }

  .full-index h2 {
    margin: 0 0 .75rem;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
  }

  .full-index h2 a { text-decoration: none; }

  .full-index ul {
    display: grid;
    gap: .4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .full-index a { text-decoration: none; }
  .full-index a:hover { color: var(--coral); }
</style>
