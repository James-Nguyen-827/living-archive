---
interface Props {
  href: string;
  title: string;
}

const { href, title } = Astro.props;
---

<a class="next-project" href={href}>
  <span>Continue to</span>
  <strong>{title}</strong>
</a>

<style>
  .next-project {
    display: grid;
    gap: .35rem;
    margin-top: clamp(3.5rem, 8vw, 6rem);
    padding-block: 1.25rem;
    border-block: 1px solid var(--line);
    text-decoration: none;
  }

  .next-project span {
    color: var(--muted-ink);
    font: 600 .78rem/1.2 var(--display);
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .next-project strong {
    font: 600 clamp(1.8rem, 5vw, 3.5rem)/.95 var(--display);
  }

  .next-project:hover strong {
    color: var(--coral);
  }
</style>
