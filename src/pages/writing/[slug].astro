---
import { getCollection, render } from 'astro:content';
import EntryLayout from '../../layouts/EntryLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('writing');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const date = new Intl.DateTimeFormat('en', { dateStyle: 'long' }).format(entry.data.publishDate);
---

<EntryLayout title={entry.data.title} summary={entry.data.summary} meta={`${date} / ${entry.data.tags.join(' · ')}`} section="writing">
  <Content />
</EntryLayout>
