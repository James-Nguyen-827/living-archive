---
import { getCollection, render } from 'astro:content';
import EntryLayout from '../../layouts/EntryLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('interests', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<EntryLayout title={entry.data.title} summary={entry.data.summary} meta={`${entry.data.year} / ${entry.data.status} / ${entry.data.tags.join(' · ')}`} section="interests">
  <Content />
</EntryLayout>
