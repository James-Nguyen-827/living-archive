---
import { getCollection } from 'astro:content';
import { PROJECTS_INTRO } from '../../config/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import ContentIndex from '../../components/ContentIndex.astro';

const entries = (await getCollection('projects')).sort((a, b) => b.data.year - a.data.year);
const items = entries.map((entry) => ({
  href: `/projects/${entry.id}`,
  title: entry.data.title,
  summary: entry.data.summary,
  meta: String(entry.data.year),
}));
---

<BaseLayout title="Projects" description="Things built—finished work and projects still in motion.">
  <PageIntro section="projects" title="Projects" description={PROJECTS_INTRO} />
  <ContentIndex items={items} />
  {entries.length === 0 && <p class="empty-state">Nothing here yet.</p>}
</BaseLayout>
