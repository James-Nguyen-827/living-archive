---
import { getCollection } from 'astro:content';
import { EMPLOYMENT_INTRO } from '../../config/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import ContentIndex from '../../components/ContentIndex.astro';

const entries = (await getCollection('employment')).sort((a, b) => a.data.order - b.data.order);
const items = entries.map((entry) => ({
  href: `/employment/${entry.id}`,
  title: entry.data.title,
  summary: entry.data.summary,
  meta: `${entry.data.year} · ${entry.data.role}`,
}));
---

<BaseLayout title="Employment" description="Selected professional work, including complete case studies and projects still in motion.">
  <PageIntro section="employment" title="Employment" description={EMPLOYMENT_INTRO} />
  <ContentIndex items={items} />
</BaseLayout>
