---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { WorldExplorer } from '../components/world/WorldExplorer';
import type { ZoneData } from '../components/world/world-content';
import { WORLD_MAP } from '../components/world/world-map';
import { validateWorld } from '../components/world/world-validator';
import { site } from '../config/site';

const [work, notes, archive] = await Promise.all([
  getCollection('work'),
  getCollection('notes'),
  getCollection('archive'),
]);

const worldIssues = validateWorld(WORLD_MAP);
if (worldIssues.length > 0) {
  throw new Error(`World validation failed:\n${worldIssues.map((issue) => `${issue.code}: ${issue.detail}`).join('\n')}`);
}

const zones: ZoneData[] = [
  {
    id: 'work', label: 'Work', href: '/work',
    summary: 'Selected professional systems, services, identities, and tools—with the decisions visible.',
    entries: work.sort((a, b) => a.data.order - b.data.order).slice(0, 5).map((entry) => ({ title: entry.data.title, href: `/work/${entry.id}`, meta: `${entry.data.year} · ${entry.data.status}`, summary: entry.data.summary })),
  },
  {
    id: 'field-notes', label: 'Field Notes', href: '/notes',
    summary: 'Observations on design, architecture, interfaces, and the practice around them.',
    entries: notes.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()).slice(0, 4).map((entry) => ({ title: entry.data.title, href: `/notes/${entry.id}`, meta: new Intl.DateTimeFormat('en', { year: 'numeric', month: 'short' }).format(entry.data.publishDate), summary: entry.data.summary })),
  },
  {
    id: 'experiments', label: 'Experiments', href: '/experiments',
    summary: 'Prototypes and small systems with permission to stay unresolved.',
    entries: archive.filter((entry) => entry.data.kind === 'experiment').map((entry) => ({ title: entry.data.title, href: `/experiments/${entry.id}`, meta: `${entry.data.year} · ${entry.data.status}`, summary: entry.data.summary })),
  },
  {
    id: 'hobbies', label: 'Hobbies', href: '/hobbies',
    summary: 'Things I return to without needing them to become work.',
    entries: archive.filter((entry) => entry.data.kind === 'hobby').map((entry) => ({ title: entry.data.title, href: `/hobbies/${entry.id}`, meta: `${entry.data.year} · ${entry.data.status}`, summary: entry.data.summary })),
  },
  {
    id: 'about', label: 'About', href: '/about',
    summary: 'The person, interests, and working principles maintaining this place.',
    entries: [],
  },
];

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.owner,
  url: site.url,
  email: `mailto:${site.email}`,
  sameAs: site.profiles.map((profile) => profile.href),
};
---

<BaseLayout>
  <div class="home-world">
    <h1 class="visually-hidden">Living Archive</h1>
    <WorldExplorer zones={zones} client:load />
  </div>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />
</BaseLayout>

<style>
  .home-world { position: relative; }
</style>
