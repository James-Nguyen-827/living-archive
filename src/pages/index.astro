---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { WorldExplorer } from '../components/world/WorldExplorer';
import type { ZoneData } from '../components/world/world-content';
import { WORLD_MAP } from '../components/world/world-map';
import { validateWorld } from '../components/world/world-validator';
import { BLOGS_EMPTY_MESSAGE, INTERESTS_EMPTY_MESSAGE, ABOUT_SUMMARY, site } from '../config/site';

const [employment, writing, projects, interests] = await Promise.all([
  getCollection('employment'),
  getCollection('writing'),
  getCollection('projects'),
  getCollection('interests', ({ data }) => !data.draft),
]);

const worldIssues = validateWorld(WORLD_MAP);
if (worldIssues.length > 0) {
  throw new Error(`World validation failed:\n${worldIssues.map((issue) => `${issue.code}: ${issue.detail}`).join('\n')}`);
}

const zones: ZoneData[] = [
  {
    id: 'employment', label: 'Employment', href: '/employment',
    summary: 'Selected professional systems, services, identities, and tools—with the decisions visible.',
    entries: employment.sort((a, b) => a.data.order - b.data.order).slice(0, 5).map((entry) => ({ title: entry.data.title, href: `/employment/${entry.id}`, meta: `${entry.data.year} · ${entry.data.status}`, summary: entry.data.summary })),
  },
  {
    id: 'writing', label: 'Blogs', href: '/writing',
    summary: 'A quiet shelf for future posts—currently between drafts.',
    emptyMessage: BLOGS_EMPTY_MESSAGE,
    entries: writing.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()).slice(0, 4).map((entry) => ({ title: entry.data.title, href: `/writing/${entry.id}`, meta: new Intl.DateTimeFormat('en', { year: 'numeric', month: 'short' }).format(entry.data.publishDate), summary: entry.data.summary })),
  },
  {
    id: 'projects', label: 'Projects', href: '/projects',
    summary: 'Things built—finished work and projects still in motion.',
    entries: projects.map((entry) => ({
      title: entry.data.title,
      href: `/projects/${entry.id}`,
      meta: `${entry.data.year} · ${entry.data.status}`,
      summary: entry.data.summary,
      previewImage: entry.data.previewImage,
      previewAlt: entry.data.previewAlt,
    })),
  },
  {
    id: 'interests', label: 'Interests', href: '/interests',
    summary: 'Things I return to without needing them to become work.',
    emptyMessage: INTERESTS_EMPTY_MESSAGE,
    entries: interests.map((entry) => ({ title: entry.data.title, href: `/interests/${entry.id}`, meta: `${entry.data.year} · ${entry.data.status}`, summary: entry.data.summary })),
  },
  {
    id: 'about', label: 'About', href: '/about',
    summary: ABOUT_SUMMARY,
    entries: [],
  },
];

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.owner,
  ...(site.url ? { url: site.url } : {}),
  email: `mailto:${site.email}`,
  sameAs: site.profiles.map((profile) => profile.href),
};
---

<BaseLayout>
  <h1 class="visually-hidden">{site.name}</h1>
  <div class="home-world">
    <WorldExplorer zones={zones} client:load />
  </div>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />
</BaseLayout>
