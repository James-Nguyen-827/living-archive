---
import { getCollection, render } from 'astro:content';
import EntryLayout from '../../layouts/EntryLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('archive', ({ data }) => data.kind === 'experiment');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<EntryLayout title={entry.data.title} summary={entry.data.summary} meta={`${entry.data.year} / experiment / ${entry.data.tags.join(' · ')}`}>
  <Content />
</EntryLayout>
