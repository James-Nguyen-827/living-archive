---
import BaseLayout from './BaseLayout.astro';
import SectionMark, { type SectionKind } from '../components/SectionMark.astro';

interface Props {
  title: string;
  summary: string;
  meta: string;
  kind?: 'website' | 'article';
  image?: string;
  section: SectionKind;
}

const { title, summary, meta, section, kind = 'article', image = '/og/archive.png' } = Astro.props;
---

<BaseLayout title={title} description={summary} kind={kind} image={image}>
  <article class="article-shell">
    <header class="article-head">
      <div class="article-head__copy">
        <p class="article-meta meta-list">{meta}</p>
        <h1>{title}</h1>
        <p class="article-summary">{summary}</p>
      </div>
      <SectionMark section={section} />
    </header>
    <div class="article-body"><slot /></div>
  </article>
</BaseLayout>
